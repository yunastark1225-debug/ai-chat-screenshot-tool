{
  "manifest_version": 3,
  "name": "AI Chat Full Page Capture",
  "version": "0.2.0",
  "key": "",
  "description": "Capture the current Chrome page from top to bottom and copy it directly to the clipboard. No file is saved.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "clipboardWrite",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Capture full page to clipboard"
  },
  "commands": {
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Capture full page to clipboard"
    },
    "capture-full-page-and-paste": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Capture full page and paste the PNG into the focused Chrome input"
    }
  },
  "minimum_chrome_version": "116"
}
